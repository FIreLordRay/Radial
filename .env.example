# Radial config. Copy this file to .env and fill in real values.
# .env is gitignored -- never commit your real Plaky API key.

# ---------------------------------------------------------------------------
# Plaky
# ---------------------------------------------------------------------------

# Generate at plaky.com: profile picture -> Preferences -> Advanced ->
# Manage API keys -> Generate API key. Leave blank to run Radial with no
# Plaky connection (local-only backlog, sync features disabled).
PLAKY_API_KEY=

# Only change this if Plaky tells you to use an account-prefixed host
# (https://<account>.api.plaky.com).
PLAKY_BASE_URL=https://api.plaky.com

# How often (seconds) Radial pulls automatically in the background, in
# addition to the always-available manual "Pull from Plaky" button. 0
# disables automatic pulling entirely.
AUTO_PULL_INTERVAL_SECONDS=300

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

HOST=127.0.0.1
PORT=5100

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

DATABASE_PATH=./data/radial.db
